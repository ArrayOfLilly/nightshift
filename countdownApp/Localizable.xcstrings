    "help.countdown.expand.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any row to open the full-screen detail view. From there you can adjust the deadline with steppers, toggle between remaining time and deadline date, manage notes, toggle the expiry sound, and delete the slot."
          }
        }
      }
    },
    "help.countdown.expand.title" : {
