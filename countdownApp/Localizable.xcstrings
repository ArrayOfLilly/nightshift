    "help.calculate.deadlines.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save named deadlines to quickly recalculate the remaining time from any reference date."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ments el névvel ellátott határidőket, hogy bármikor gyorsan újraszámolhasd a hátralévő időt egy tetszőleges referencia-dátumtól."
          }
        }
      }
    },
    "help.calculate.deadlines.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved deadlines"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentett határidők"
          }
        }
      }
    },
    "help.calculate.load.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a saved deadline in the list to open its detail sheet, then tap LOAD AS TO to copy its date into the TO stepper. From the detail sheet you can also rename or delete the deadline."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy mentett határidore a listában a részletek megnyitásához, majd a LOAD AS TO gombbal másold a dátumát a TO stepperbe. A részletnézetben a határidot át is nevezheted vagy törölheted."
          }
        }
      }
    },
    "help.calculate.load.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading a deadline"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Határidő betöltése"
          }
        }
      }
    },
    "help.calculate.reset.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RESET FROM NOW sets the FROM date to the current moment. RESET TO NOW sets the TO date to the current moment. Use these to quickly anchor one end of the interval to now."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A RESET FROM NOW a FROM dátumot állítja a jelenlegi időpontra. A RESET TO NOW a TO dátumot állítja a jelenlegi időpontra. Ezekkel gyorsan rögzítheted az intervallum egyik végét a mostani pillanathoz."
          }
        }
      }
    },
    "help.calculate.reset.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset buttons"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Visszaállító gombok"
          }
        }
      }
    },
    "help.calculate.stepper.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each date row has five steppers: YEAR, MON, DAY, HOUR, MIN. A single click moves the value by one step. Click and hold a chevron to repeat automatically for fast navigation."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden dátumsornak öt steppere van: YEAR, MON, DAY, HOUR, MIN. Egyetlen kattintás egy lépéssel módosítja az értéket. Tartsd lenyomva a nyilat a gyors, automatikus léptetéshez."
          }
        }
      }
    },
    "help.calculate.stepper.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the steppers"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A stepperek használata"
          }
        }
      }
    },
    "help.calculate.sunpanel.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the crescent moon icon to reveal sunrise and sunset times for the selected date and location."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a holdsarló ikonra, hogy megjelenjen a napkelte és napnyugta időpontja a kiválasztott dátumhoz és helyhez."
          }
        }
      }
    },
    "help.calculate.sunpanel.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sun panel"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nap panel"
          }
        }
      }
    },
    "help.calculate.toggle.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result below the steppers shows the time difference. A toggle button switches between DAYS (total elapsed days as a single number) and CAL (calendar breakdown: years, months, and days separately). The toggle state is remembered across launches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A stepperek alatti eredmény mutatja az időkülönbséget. Egy váltógomb kapcsol a DAYS (összes eltelt nap egyetlen számként) és a CAL (naptári bontás: év, hónap és nap külön) nézet között. A választott mód indítások között is megmarad."
          }
        }
      }
    },
    "help.calculate.toggle.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result display"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eredmény megjelenítése"
          }
        }
      }
    },
    "help.countdown.add.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the + button in the toolbar to open the Add sheet. Set a name, target date, and optional color."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a + gombra az eszköztárban az Add ablak megnyitásához. Add meg a nevet, a célidőpontot, és opcionálisan egy színt."
          }
        }
      }
    },
    "help.countdown.add.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding an item"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elem hozzáadása"
          }
        }
      }
    },
    "help.countdown.copy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the dark label pill on any row to copy the item's name to the clipboard. The pill briefly shows COPIED to confirm. A separate copy button is also available in the detail view next to the editable label."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints bármelyik sor sötét címke-gombjára a tétel nevének vágólapra másolásához. A gomb röviden COPIED feliratot mutat megerősítésként. A részletnézetben, a szerkeszthető címke mellett is elérhető egy külön másoló gomb."
          }
        }
      }
    },
    "help.countdown.copy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying the label"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A címke másolása"
          }
        }
      }
    },
    "help.countdown.edit.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click an item to expand it, then use the pencil icon to open the Edit sheet."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy elemre a kibontásához, majd a ceruza ikonnal nyisd meg a szerkesztő ablakot."
          }
        }
      }
    },
    "help.countdown.edit.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing an item"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elem szerkesztése"
          }
        }
      }
    },
    "help.countdown.expand.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any row to open the full-screen detail view. From there you can adjust the deadline with steppers, toggle between remaining time and deadline date, manage notes, toggle the expiry sound, and delete the slot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints bármelyik sorra a teljes képernyős részletnézet megnyitásához. Itt a stepperekkel módosíthatod a határidőt, válthatsz a hátralévő idő és a határidő dátuma között, kezelheted a jegyzeteket, be- vagy kikapcsolhatod a lejárati hangot, és törölheted a slotot."
          }
        }
      }
    },
    "help.countdown.expand.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening an item"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elem megnyitása"
          }
        }
      }
    },
    "help.countdown.free.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a countdown reaches its deadline, the row turns amber and shows FREE ✓. Free slots collect at the bottom of the list and can be dragged to reorder. If the expiry sound is enabled for that slot, a chime plays the moment the deadline passes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor egy visszaszámlálás eléri a határidejét, a sor borostyánszínure vált és FREE ✓ jelzést mutat. A szabad slotok a lista alján gyűlnek össze, és húzással átrendezhetők. Ha az adott slothoz be van kapcsolva a lejárati hang, egy csengőhang szólal meg a határidő elérésekor."
          }
        }
      }
    },
    "help.countdown.free.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free slots"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabad slotok"
          }
        }
      }
    },
    "help.countdown.notes.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The eye badge on an expanded item opens the Notes sheet, where you can write freeform markdown notes attached to that countdown."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kibontott elemen látható szem-jelvény megnyitja a jegyzet ablakot, ahol szabad formátumú markdown jegyzeteket írhatsz az adott visszaszámláláshoz."
          }
        }
      }
    },
    "help.countdown.notes.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes badge"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyzet jelvény"
          }
        }
      }
    },
    "help.countdown.reorder.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-press and drag an item to change its position in the list."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosszan nyomva tartva húzd az elemet a listában elfoglalt helyének megváltoztatásához."
          }
        }
      }
    },
    "help.countdown.reorder.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordering items"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemek átrendezése"
          }
        }
      }
    },
    "help.countdown.toggle.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock/calendar button on an active row switches between showing the remaining countdown time and the actual deadline date. The display choice is saved per item and remembered across launches."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy aktív soron az óra/naptár gomb vált a hátralévő visszaszámlálási idő és a tényleges határidő dátuma megjelenítése között. A választás elemenként elmentve, indítások között is megmarad."
          }
        }
      }
    },
    "help.countdown.toggle.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time display toggle"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Időmegjelenítés váltó"
          }
        }
      }
    },
    "help.menu.item": {
      "comment": "Help menu item label",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NightShift Help"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "NightShift súgó"
          }
        }
      }
    },
    "help.overview.cooldowns.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each countdown item tracks when a free-tier AI account — Claude, Codex, ChatGPT, DeepSeek, Qwen, Kimi, and others — becomes available again, so you always know which model to switch to next."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden visszaszámlálás elem azt követi, hogy egy ingyenes AI fiók — Claude, Codex, ChatGPT, DeepSeek, Qwen, Kimi és mások — mikor válik újra elérhetővé, így mindig tudod, melyik modellre válts legközelebb."
          }
        }
      }
    },
    "help.overview.cooldowns.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown tracks AI cooldowns"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Countdown az AI-fiókok újratöltési idejét követi"
          }
        }
      }
    },
    "help.overview.schedule.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development happens at night — once it starts getting light outside, it's time to sleep. The Calculate tab's sun panel shows tonight's sunrise, so you always know how much of the night is left to work with."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fejlesztés éjjel zajlik — amint kezd világosodni, ideje aludni. A Calculate fül nap-panelje mutatja az aznapi napkeltét, így mindig tudod, mennyi idő maradt még dolgozni az éjszakából."
          }
        }
      }
    },
    "help.overview.schedule.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sunrise deadline"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A napkelte mint határidő"
          }
        }
      }
    },
    "help.overview.views.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between Countdown, Calculate, and Snippets using the tab bar at the top of the window."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válts a Countdown, Calculate és Snippets nézetek között az ablak tetején lévő fülsávval."
          }
        }
      }
    },
    "help.overview.views.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Views at a glance"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A nézetek egy pillantásra"
          }
        }
      }
    },
    "help.overview.what.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NightShift is a personal workspace for developing side projects at night with free-tier AI coding assistants. It tracks which AI accounts are on cooldown, keeps your side-project deadlines, and shows how much of the night is left before sunrise."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NightShift egy személyes munkatér side projektek éjszakai fejlesztéséhez, ingyenes AI kódoló asszisztensek segítségével. Nyomon követi, mely AI fiókok vannak éppen újratöltési időszakban, tárolja a side project határidőket, és megmutatja, mennyi van hátra az éjszakából napkeltéig."
          }
        }
      }
    },
    "help.overview.what.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is NightShift?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi az a NightShift?"
          }
        }
      }
    },
    "help.recovery.banner.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If stored data could not be read at startup — for example due to corruption — a banner appears listing how many items were lost. Those items are not visible in the app and are not active. Tap Copy Raw Data first to preserve the raw JSON on your clipboard; once you dismiss the banner, that clipboard copy is your only way to recover the data."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha indításkor a tárolt adatok nem voltak beolvashatók — például sérülés miatt —, egy sáv jelenik meg, amely megmutatja, hány elem veszett el. Ezek az elemek nem láthatók az appban és nem aktívak. Koppints előbb a Copy Raw Data gombra, hogy a nyers JSON-t megőrizd a vágólapon — miután bezárod a sávot, ez a vágólap-másolat az egyetlen módja az adatok visszaszerzésének."
          }
        }
      }
    },
    "help.recovery.banner.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery banner"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyreállítási sáv"
          }
        }
      }
    },
    "help.recovery.storage.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data — countdown slots, deadlines, notes, and snippets — is stored locally on this Mac in UserDefaults. There is no iCloud or cloud sync."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden adat — visszaszámlálás slotok, határidők, jegyzetek és snippetek — helyben, ezen a Macen tárolódik a UserDefaults-ban. Nincs iCloud vagy felhő szinkronizáció."
          }
        }
      }
    },
    "help.recovery.storage.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyi tárolás"
          }
        }
      }
    },
