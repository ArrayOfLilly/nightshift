    "help.snippets.copy.body": {
      "comment": "Body text for the \"Copy\" snippet help item.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the copy icon next to a snippet to copy its body to the clipboard. The icon briefly shows a checkmark to confirm."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a másoló ikonra egy snippet mellett, hogy a tartalmát a vágólapra másold. Az ikon röviden egy pipát mutat megerősítésként."
          }
        }
      }
    },
    "help.snippets.copy.title": {
      "comment": "Title of a help item in the Snippets section.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying a snippet"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippet másolása"
          }
        }
      }
    },
    "help.snippets.edit.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the chevron menu on a snippet row to Edit or Delete it. Use the checkmark to save, or X to discard changes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a snippet sor nyílmenüjére a szerkesztéshez (Edit) vagy törléshez (Delete). A pipával mentheted, az X-szel elvetheted a módosításokat."
          }
        }
      }
    },
    "help.snippets.edit.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing a snippet"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippet szerkesztése"
          }
        }
      }
    },
    "help.snippets.what.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snippets are reusable markdown notes, organized by project. Use them to store recurring text blocks, templates, or session context."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A snippetek újrafelhasználható, projekt szerint rendezett markdown jegyzetek. Ismétlődő szövegblokkok, sablonok vagy session kontextus tárolására használhatod őket."
          }
        }
      }
    },
    "help.snippets.what.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What are snippets?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mik azok a snippetek?"
          }
        }
      }
    },
