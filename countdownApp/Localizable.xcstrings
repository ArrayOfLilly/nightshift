    "help.overview.cooldowns.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each countdown item tracks when a free-tier AI account — Claude, Codex, ChatGPT, DeepSeek, Qwen, Kimi, and others — becomes available again, so you always know which model to switch to next."
          }
        }
      }
    },
    "help.overview.cooldowns.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdown tracks AI cooldowns"
          }
        }
      }
    },
    "help.overview.schedule.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Development happens at night — once it starts getting light outside, it's time to sleep. The Calculate tab's sun panel shows tonight's sunrise, so you always know how much of the night is left to work with."
          }
        }
      }
    },
    "help.overview.schedule.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sunrise deadline"
          }
        }
      }
    },
    "help.overview.views.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch between Countdown, Calculate, and Snippets using the tab bar at the top of the window."
          }
        }
      }
    },
    "help.overview.views.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Views at a glance"
          }
        }
      }
    },
    "help.overview.what.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NightShift is a personal workspace for developing side projects at night with free-tier AI coding assistants. It tracks which AI accounts are on cooldown, keeps your side-project deadlines, and shows how much of the night is left before sunrise."
          }
        }
      }
    },
    "help.overview.what.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is NightShift?"
          }
        }
      }
    },
    "help.recovery.banner.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If stored data could not be read at startup — for example due to corruption — a banner appears listing how many items were lost. Those items are not visible in the app and are not active. Tap Copy Raw Data first to preserve the raw JSON on your clipboard; once you dismiss the banner, that clipboard copy is your only way to recover the data."
          }
        }
      }
    },
    "help.recovery.banner.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recovery banner"
          }
        }
      }
    },
    "help.recovery.storage.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All data — countdown slots, deadlines, notes, and snippets — is stored locally on this Mac in UserDefaults. There is no iCloud or cloud sync."
          }
        }
      }
    },
    "help.recovery.storage.title" : {
      "localizations" : {
