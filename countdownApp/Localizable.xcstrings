    },
    "help.calculate.toggle.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The result below the steppers shows the time difference. A toggle button switches between DAYS (total elapsed days as a single number) and CAL (calendar breakdown: years, months, and days separately). The toggle state is remembered across launches."
          }
        }
      }
    },
